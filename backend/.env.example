# ==========================================================
# HARU-EMOCHI (Multi-User Scalable AI Character Platform)
# ==========================================================

# Database URL:
# - Local / Dev (SQLite WAL mode for concurrent reads/writes):
DATABASE_URL=sqlite+aiosqlite:///./haru_emochi.db
# - Production (PostgreSQL for thousands of concurrent users):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/haru_emochi

# Security
JWT_SECRET_KEY=haru-emochi-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOURS=168

# Concurrency & Rate Limiting (per user)
MAX_CONCURRENT_LLM_REQUESTS=200
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# LLM Provider API Keys (Server-level defaults; users can also provide BYOK in UI)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Server Host & Port
HOST=0.0.0.0
PORT=5050
