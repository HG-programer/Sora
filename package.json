{
  "name": "sora-platform",
  "version": "2.0.0",
  "description": "Sora: Multi-user AI Character & Roleplay platform with Android Capacitor & PWA support",
  "private": true,
  "scripts": {
    "start:backend": "python backend/app.py",
    "android:add": "npx @capacitor/cli add android",
    "android:sync": "npx @capacitor/cli sync android",
    "android:open": "npx @capacitor/cli open android",
    "test:concurrency": "python tests/load_test_multiuser.py"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
